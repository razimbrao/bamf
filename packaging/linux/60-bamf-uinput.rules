# Give the logged-in (seat) user access to /dev/uinput so bamf-client can
# create virtual input devices without root and without joining the `input`
# group (which would allow reading every input device).
#
# Install:
#   sudo cp 60-bamf-uinput.rules /etc/udev/rules.d/
#   sudo udevadm control --reload && sudo udevadm trigger --name-match=uinput
# Must sort before 73-seat-late.rules for `uaccess` to apply.
KERNEL=="uinput", SUBSYSTEM=="misc", TAG+="uaccess", OPTIONS+="static_node=uinput"
